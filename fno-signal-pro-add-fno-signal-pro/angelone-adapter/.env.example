# ---- Angel One SmartAPI credentials (required) ----
# Create an API key at https://smartapi.angelbroking.com/ (Publisher/Trading app).
ANGEL_API_KEY=your_smartapi_key
ANGEL_CLIENT_CODE=your_client_code
ANGEL_MPIN=your_login_mpin
# Base32 secret from your authenticator app QR (the TOTP seed), NOT the 6-digit code.
ANGEL_TOTP_SECRET=your_totp_secret

# ---- Adapter access secret ----
# Set the SAME value in the plugin: Settings -> Data API Key.
ADAPTER_SECRET=choose_a_long_random_string

# ---- Optional tuning ----
TRACK_INSTRUMENTS=NIFTY,BANKNIFTY,FINNIFTY,MIDCPNIFTY
CANDLE_INTERVAL=FIFTEEN_MINUTE
INDICATOR_REFRESH_SEC=60
OPTIONCHAIN_REFRESH_SEC=30
RISK_FREE_RATE=0.065
HOST=0.0.0.0
PORT=8080

# Optional: force index spot tokens if auto-resolve fails.
# INDEX_TOKEN_OVERRIDES=NIFTY:26000,BANKNIFTY:26009
